# Your UDI login (only used if the direct booking link stops working)
UDI_EMAIL=you@example.com
UDI_PASSWORD=

# The mailbox that receives UDI/police emails. Gmail: create an App Password at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification). 16 letters, no spaces.
GMAIL_ADDRESS=you@example.com
GMAIL_APP_PASSWORD=
# Where notifications go (defaults to GMAIL_ADDRESS)
NOTIFY_TO=

# The booking number from UDI's receipt page / the police's "Book an appointment" email
BOOKING_NUMBER=
# Optional: paste the full "Book appointment" link instead (overrides BOOKING_NUMBER)
BOOKING_URL=

# true = book automatically; false = only email you when a slot is free
AUTO_BOOK=true
# Never auto-book a slot that starts sooner than this many hours (you get an email instead)
MIN_HOURS_AHEAD=12

# Optional, for non-Gmail mailboxes (untested)
# IMAP_HOST=imap.gmail.com
# SMTP_HOST=smtp.gmail.com
